#Split-Plot Experiment (Example 17)

Data <- c(
  2.17, 1.88, 1.62, 2.34,
  1.58, 1.26, 1.22, 1.59,
  2.29, 1.60, 1.67, 1.91,
  
  2.33, 2.01, 1.70, 1.78,
  1.38, 1.30, 1.85, 1.09, 
  1.86, 1.70, 1.81, 1.54,
  
  1.75, 1.95, 2.13, 1.78,
  1.52, 1.47, 1.80, 1.37,
  1.55, 1.61, 1.82, 1.56 
)

#Factor Setup
Temp <- factor(rep(c("Low", "Medium", "High"), each = 12), levels = c("Low", "Medium", "High"))
Elec <- factor(rep(rep(c("A", "B", "C"), each = 4), times = 3))
Replicate   <- factor(rep(1:4, times = 9))

df <- data.frame(Replicate, Temp, Elec, Data)

# 11 Orthogonal components

model <- aov(Data ~ Replicate + Temp * Elec, data = df)

# ৪. Orthogonal Components ভেঙে ANOVA Table প্রদর্শন (Image 2 এর নিয়মে)
summary(model, split = list(
  Temp = list(
    "T_Linear"    = 1,
    "T_Quadratic" = 2
  ),
  Elec = list(
    "E_Linear"    = 1,
    "E_Quadratic" = 2
  ),
  "Temp:Elec" = list(
    "TL x EL" = 1,
    "TL x EQ" = 2,
    "TQ x EL" = 3,
    "TQ x EQ" = 4
  )
))



#Split-Plot ANOVA Model
split_model <- aov(Data ~ Replicate + Temp * Elec + Error(Replicate:Temp), data = df)

# ANOVA Table
summary(split_model)






