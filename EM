# Question No. 2, Q.2:
# ==========================================
act.data <- read.table("act.txt", sep=",", header=TRUE)
str(act.data)
table(act.data$Marital.status)

library(randomForest)
library(caret)

act.data$Income <- factor(act.data$Income)
act.data$Marital.status <- factor(act.data$Marital.status)

ID <- 4101      # Use the last 4 difits of your Student ID
set.seed(ID)
trainIndex <- createDataPartition(act.data$Income, p = 0.70, list = FALSE)
train.data <- act.data[trainIndex, ]
test.data <- act.data[-trainIndex, ]

rf.model <- randomForest(formula = Income ~ Marital.status +
                     Cap_Gains_Losses, data = train.data, 
                     ntree = 100, type = 'classification')

rf.model$predicted
table(rf.model$predicted)

predictions <- predict(rf.model, newdata = test.data)
conf.matrix <- table(Actual = test.data$Income, Predicted = predictions)
print(conf.matrix)

accuracy <- sum(diag(conf.matrix)) / sum(conf.matrix)
print(paste("Accuracy:", round(accuracy, 4)))

error.rate <- 1 - accuracy
print(c(accuracy, error.rate))
# ============================================

# Calculate metrics manually
TP <- conf.matrix[2, 2] # True Positives
TN <- conf.matrix[1, 1] # True Negatives
FP <- conf.matrix[2, 1] # False Positives
FN <- conf.matrix[1, 2] # False Negatives

#Sensitivity (Recall): TP / (TP + FN)
sensitivity <- TP / (TP + FN)
cat("\nSensitivity (Recall):", round(sensitivity, 3))

specificity <- TN / (TN + FP)
cat("\nSpecificity:", round(specificity, 3))

# Precision: TP / (TP + FP)
precision <- TP / (TP + FP)
cat("\nPrecision:", round(precision, 3))

f1_score <- 2 * (precision * sensitivity) / (precision + sensitivity)
cat("\nF1 Score:", round(f1_score, 3))
