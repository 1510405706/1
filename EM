var_ld <- (s2_y * (1 - r2) / n) + (s2_y * r2 / n_prime); var_ld

est_var = var_ld * 100^2; est_var
sampling_error <- sqrt(est_var); sampling_error

# Relative Precision / Gain in Efficiency
