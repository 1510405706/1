###OC function

h0=0
h1=1
A=(1-b)/a
B=b/(1-a)
Ltheta=function(theta){
  (A^((h1+h0-2*theta)/(h1-h0))-1)/(A^((h1+h0-2*theta)/
                                        (h1-h0))-B^((h1+h0-2*theta)/(h1-h0)))
}
Ltheta
