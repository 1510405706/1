# PPSWOR Estimation for n = 2 (Example 5.5)

# Population Probabilities (p_k) from Table
p_pop <- c(0.185, 0.111, 0.093, 0.148, 0.096, 0.163, 0.074, 0.130)

y1 <- 30; 
p1 <- 0.096
y2 <- 22; 
p2 <- 0.074


# (i) Des Raj Ordered Estimator

t1 <- (y1 / p1)* (1 + p1)
t2 <- (y2 / p2) * (1 - p1)

Y_DR  <- (t1 + t2) / 2;Y_DR
 
V_DR  <- ((1 - p1)^2 / 4) * ((y1 / p1) - (y2 / p2))^2
SE_DR <- sqrt(V_DR);SE_DR


# (ii) Murthy Unordered Estimator
Y_M  <- (1 / (2 - p1 - p2)) * ((y1 / p1) * (1 - p2) + (y2 / p2) * (1 - p1));Y_M
V_M  <- ((1 - p1) * (1 - p2) * (1 - p1 - p2) / (2 - p1 - p2)^2) * ((y1 / p1) - (y2 / p2))^2
SE_M <- sqrt(V_M);SE_M


# (iii) Horvitz-Thompson (HT) Estimator

# Inclusion probabilities (pi_1, pi_2) for n = 2 PPSWOR
C <- sum(p_pop / (1 - p_pop))
pi1  <- p1 * (1 + C - (p1 / (1 - p1)));pi1
pi2  <- p2 * (1 + C - (p2 / (1 - p2)));pi2

# Joint inclusion probability (pi_12)
pi12 <- (p1 * p2 * (2 - p1 - p2)) / ((1 - p1) * (1 - p2))

# HT Total Estimate & Yates-Grundy Variance Estimate
Y_HT     <- (y1 / pi1) + (y2 / pi2)
V_HT_SYG <- ((pi1 * pi2 - pi12) / pi12) * ((y1 / pi1) - (y2 / pi2))^2
SE_HT    <- sqrt(V_HT_SYG);SE_HT






