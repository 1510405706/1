m=array(1:20)
d=array(1:20)
R=array(1:20)
a=0.05
b=0.10
LA=log((1-b)/a)
LB=log(b/(1-a))  
R[1]=x[1]-0.5
m[1]=1
for(i in 1:20){
  if(R[i]>LA){
    d[i]='H1 is accepted'
    break
  }
  else if (R[i]<LB){
    d[i]="H0 accepted"
    break
  }
  else {
    d[i]="Continue"
    R[i+1]=R[i]+x[i+1]-0.5
    m[i+1] <- m[i]+1
  }
}

iter <- data.frame(m,R,d)
iter

