library(lubridate)
library(tseries)
library(rugarch)
library(FinTS)
library(e1071)
library(forecast)
library(xts)


# i)) Read the data 
## plot the data and make it into return series
aal_data <- read.csv(file.choose())
aal_data$date <- mdy(aal_data$date)
# make the data into time series
aal_xts <- xts(aal_data$AAL, order.by = aal_data$date)

head(aal_xts)

# Plot
plot(aal_xts, main = "AAL Stock Price", ylab = "Price")


# convert xts to ts data
aal_ts <- as.ts(aal_xts)   ## this ts data is needed for ARIMA modeling and forecasting
plot(aal_ts)


## check stationarity through unit root test

adf.test(aal_ts)            
pp.test(aal_ts)
## make the data into return series
aal=diff(log(aal_ts));aal

##ii)) ##  plot the return Series

plot(aal,type="l")
adf.test(aal)


## iii)) Find the acf and pacf and and check ARCH effect.
##Fitting mean model
par(mfrow=c(2,2))

acf(aal, main="ACF of Returns")
pacf(aal, main="PACF of Returns")
acf(aal^2, main="ACF of Squared Returns")
pacf(aal^2, main="PACF of Squared Returns")   ## if we have significant spike here that means here are ARCH effect.

## find Appropriate ARIMA model                                             ## ARCH effect is also tested trough ARCH-LM test.

arima_model <- auto.arima(aal_ts, seasonal = FALSE);arima_model
# Extract the residuals
residuals <- residuals(arima_model)
residuals_sq=residuals^2
## plot of residuals
par(mfrow = c(2, 2))
hist(residuals_sq, main = "Histogram of Residuals", xlab = "Residuals", col = "lightblue", breaks = 30)


plot(density(residuals_sq), main = "Density Plot of Residuals")
## Normality test
# Normality Test
shapiro.test(residuals_sq)
jarque.bera.test(residuals_sq)      ## H0: residuals are normally distributed
                                        ## we reject H0: residuals are not normal
# Conduct the ARCH test
arch_test <- ArchTest(residuals) ## bacground use ARCH-LM test
print(arch_test)

##d) 
## Fit GARCH and TGARCH model

aal_return <- na.omit(diff(log(aal_ts)))

# GARCH(1,1)



g_fit  <- ugarchfit(ugarchspec(variance.model = list(garchOrder=c(1,1))), 
                    data = aal_return)
##TGARCH(1,1)
tg_fit <- ugarchfit(ugarchspec(variance.model = list(garchOrder=c(1,1), 
                                                     model="gjrGARCH")), data = aal_return)
 ## EGARCH(1,1)
eg_fit <- ugarchfit( ugarchspec( variance.model = list( garchOrder = c(1,1),model = "eGARCH")),
                      data = aal_return)                
summary(g_fit)
summary(tg_fit)
summary(eg_fit)
g_resid  <- residuals(g_fit)
tg_resid <- residuals(tg_fit)
eg_resid <- residuals(eg_fit)

    ## lags 5 or 10 are standard
ArchTest(g_resid, lags = 10)


ArchTest(tg_resid, lags = 10)


ArchTest(eg_resid, lags = 10)





## e))
# Compare the models using information criteria
garch_aic <- infocriteria(g_fit);garch_aic
tg_aic <- infocriteria(tg_fit) ;tg_aic ### TGARCH is best model
eg_aic=infocriteria(eg_fit) ;eg_aic


    ## EGARCH is the best


## model accuracy check

