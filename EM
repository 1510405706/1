library(dplyr)
library(readr)
#Read Data
setwd("D:\\Practical\\510")

g1<-read_tsv("GSE87630.top.table.tsv")
upg<- g1%>%filter(adj.P.Val<.05 & logFC>.5)
upg<- upg%>%filter(!is.na(Gene.symbol))
upg<- unique(upg$Gene.symbol)
length(upg)
write.csv(upg,"Upregulated.csv")

dwg<- g1%>%filter(adj.P.Val<.05 & logFC< -.5)
dwg<- dwg%>%filter(!is.na(Gene.symbol))
dwg<- unique(dwg$Gene.symbol)
length(dwg)
write.csv(dwg,"Downregulated.csv")

deg=c(upg,dwg);length(deg)
write.csv(deg,"DEGs.csv")
