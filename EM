  )
))







#######################BIBD_Example_27 
b <- gl(10, 3)
t <- factor(c("A","B","C", "A","B","D", "A","B","E", "A","C","D", "A","C","E", 
              "A","D","E", "B","C","D", "B","C","E", "B","D","E", "C","D","E"))
y <- c(27,26,30, 28,26,29, 30,29,26, 31,34,33, 29,32,24, 30,34,25, 30,34,31, 21,31,23, 26,33,24, 33,31,26)

#(i) ANOVA Table
m <- lm(y ~ b + t)
anova(m)


v <- 5
b_num <- 10
k <- 3
r <- 6
lambda <- 3
E <-(lambda*v)/(r*k)  

# Q_j (Adjusted Treatment Totals)
T_j <- tapply(y, t, sum)
B_tj <-tapply(tapply(y, b, sum)[b], t, sum)
Q <- T_j - B_tj / k


#(ii) 
s <- sigma(m)  # s = sqrt(MSE) 
t_calc <- (Q["A"] - Q["E"]) / (s * sqrt(2 * r * E))
t_calc

# (iii)Intrablock and Interblock

tau2_intra <- Q["B"] / (r * E)  # Intrablock estimate
tau2_intra

# B_t2 = Sum of blocks which have Treatment B 
blocks_with_B <- unique(b[t == "B"])
B_t2 <- sum(y[b %in% blocks_with_B])
tau2_inter <- (B_t2 - r * k * mean(y)) / (r - lambda)  # Interblock estimate
tau2_inter

