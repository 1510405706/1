# Factor & Polynomial Contrasts Set up
Rep      <- factor(rep(1:4, times = 12))
Variety  <- factor(rep(c("V1", "V2", "V3"), each = 16), ordered = TRUE)
Nitrogen <- factor(rep(rep(c("n0", "n1", "n2", "n3"), each = 4), times = 3), ordered = TRUE)

df <- data.frame(Rep, Variety, Nitrogen, Yield)

########### Split plot design
spd_model <- aov(Yield ~ Rep + Variety * Nitrogen + Error(Rep/Variety), data = df)

summary(spd_model, split = list(
  Variety = list(
    "V_Linear"    = 1, 
    "V_Quadratic" = 2
  ),
  Nitrogen = list(
    "N_Linear"    = 1, 
    "N_Quadratic" = 2, 
    "N_Cubic"     = 3
  ),
  "Variety:Nitrogen" = list(
    "VL x NL" = 1, "VL x NQ" = 2, "VL x NC" = 3,
    "VQ x NL" = 4, "VQ x NQ" = 5, "VQ x NC" = 6
  )
))







#General Two-Factor Factorial (RCBD) ANOVA (১১টি Component-সহ)

rcbd_model <- aov(Yield ~ Rep + Variety * Nitrogen, data = df)

summary(rcbd_model, split = list(
  Variety = list(
    "V_Linear"    = 1, 
