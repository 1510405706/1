y2<- c(280.1,354.6,325.6,330.4,202.4,237.8,224.1,342.8,349.9,313.5,246.0,368.7,302.9,275.8,236.4)
z1<- c(116.2,156.6,141.2,131.9,100.9,100.9,94.1,150.6,132.1,139.6,91.4,157.9,148.3,104.9,102.7)
