library(lmtest)


data(EuStockMarkets)

plot(EuStockMarkets,col="blue",main="Daily closing values of major stock market indices of 3 countries")

head(EuStockMarkets)
Germany= EuStockMarkets[,1]
switzerland=EuStockMarkets[,2]
France= EuStockMarkets[,3]
data<- data.frame(Germany,switzerland,France)
head(data)
dev.off()

ts.plot(data,col=1:3)
legend("topleft",inset=0.05,legend=colnames(data),col=1:3,lty=1,lwd=2)

#ACF and PACF
par(mfrow=c(3,2))

acf(Germany,main="ACF of Daily closing values of Germany")
pacf(Germany,main="PACF of Daily closing values of Germany")
acf(France,main="ACF of Daily closing values of France")
pacf(France,main="PACF of Daily closing values of France")
acf(switzerland,main="ACF of Daily closing values of Uk")
pacf(switzerland,main="PACF of Daily closing values of Uk")

# Stationarity test

adf.test(Germany)  #H₀:Non-Stationary
pp.test(Germany)
kpss.test(Germany) #H₀-Stationary

adf.test(France)  #H₀:Non-Stationary
pp.test(France)
kpss.test(France)  #H₀-Stationary

adf.test(switzerland)  #H₀:Non-Stationary
pp.test(switzerland)
kpss.test(switzerland) #H₀-Stationary

# Differencing the log data
dif_log_data=diff(log(data))

adf.test(diff(log(Germany)))
pp.test(diff(log(Germany)))
kpss.test(diff(log(Germany)))

adf.test(diff(log(France)))
pp.test(diff(log(France)))
kpss.test(diff(log(France)))

adf.test(diff(log(switzerland)))
pp.test(diff(log(switzerland)))
kpss.test(diff(log(switzerland)))

### Lag Length Selection
VARselect(log(data))

##Engle-Granger

eg <- lm(Germany~switzerland+France, data)
summary(eg)

resid_eg <- residuals(eg)
adf.test(resid_eg)
pp.test(resid_eg)

##Johansen Trace Test

joh_trace <- ca.jo(
