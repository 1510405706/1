library(rvest)  # For web scraping
library(dplyr)  # For data manipulation

url <- "http://books.toscrape.com/"
webpage <- read_html(url)

# Extract book titles
titles <- webpage %>%
  html_nodes("h3 a") %>%
  html_attr("title") %>%
  na.omit()

# Extract book prices
prices <- webpage %>%
  html_nodes(".price_color") %>%
  html_text() %>%
  gsub("£", "", .) %>%  # Remove currency symbol
  as.numeric()

# Extract star ratings 
ratings <- webpage %>%
  html_nodes(".star-rating") %>%
  html_attr("class") %>%
  gsub("star-rating ", "", .) %>%
  factor(levels = c("One", "Two", "Three", "Four", "Five"),
         labels = c(1, 2, 3, 4, 5)) %>%
  as.numeric()

books_data <- data.frame(
  Title = titles[1:length(prices)],  
  Price = prices,
  Rating = ratings
)

head(books_data)

avg_price_by_rating <- books_data %>%
  group_by(Rating) %>%
  summarise(Average_Price = mean(Price),
            Count = n())

print(avg_price_by_rating)

hist(books_data$Price, 
     main = "Distribution of Book Prices",
     xlab = "Price (£)",
     col = "lightblue")

boxplot(Price ~ Rating, data = books_data,
        main = "Book Prices by Rating",
        xlab = "Star Rating",
        ylab = "Price (£)",
        col = rainbow(5))

write.csv(books_data, "book_data.csv", row.names = FALSE)
