                 13.4, 13.5, 8.3, 13.7, 14.6, 14.5, 17.1, 14.5, 11.4, 14.0,
                 8.7, 11.6, 11.5, 14.4, 17.8, 8.4, 8.7, 14.6, 12.1, 7.9, 
                 8.9, 11.1, 13.0, 10.5, 14.2, 12.7, 11.9, 15.5, 17.1, 10.9)

# Dry yield for the first 20 cuts (y)
dry_sub <- c(15.2, 11.8, 17.5, 12.5, 10.4, 10.1, 11.2, 15.8, 13.0, 10.8, 
             12.3, 12.4, 7.6, 12.5, 13.3, 13.5, 16.2, 13.5, 10.3, 12.8)

# Corresponding harvest yield for the first 20 cuts (x_n)
harvest_sub <- harvest_all[1:20]

n_prime <- 40
n <- 20

# Means
x_bar_prime <- mean(harvest_all)
x_bar_n <- mean(harvest_sub) #for sub-sample of size n.
y_bar_n <- mean(dry_sub)  #for sub-sample of size n.

# Ratio Estimate
R_hat <- y_bar_n / x_bar_n;R_hat
y_bar_rd <- R_hat * x_bar_prime
y_bar_rd
# Convert per-cut (1/100 acre) to per-acre 
avg_yield_acre <- y_bar_rd * 100
avg_yield_acre


# Variance components
s2_y <- var(dry_sub);s2_y
s2_x <- var(harvest_sub);s2_x
s_xy <- cov(dry_sub, harvest_sub);s_xy 

# Approximate Variance for Double Sampling Ratio
# Var = (1/n - 1/n')*(s2_y + R^2*s2_x - 2*R*s_xy) + (1/n')*s2_y
var_rd <- (1/n - 1/n_prime)*(s2_y + R_hat^2*s2_x - 2*R_hat*s_xy) + (1/n_prime)*s2_y 

est_var=var_rd * 100^2;est_var
sampling_error <- sqrt(est_var);sampling_error

# Relative Precision
var_simple <- (1/n) * s2_y
precision_gain <- (var_simple / var_rd) - 1
precision_gain

#(iii)

# Cost ratio
cost_ratio <- 1.5 # Dry weight cost / Harvest weight cost

# Using the formula for optimum n/n' in ratio estimation
# n/n' = sqrt( (c'/c) * (S2_y - R^2*S_xy + R*S2_x) / (R*S_xy - R^2*S2_x) )

v=s2_y +((R_hat^2)*s2_x) - (2*R_hat*s_xy);v
v_prim=2*R_hat*s_xy-(R_hat^2)*s2_x;v_prim

propor=sqrt(cost_ratio*(v/v_prim));propor



####
# Regression Coefficient (b) & Estimate
b <- s_xy / s2_x; b
y_bar_ld <- y_bar_n + b * (x_bar_prime - x_bar_n)
y_bar_ld

# Convert per-cut (1/100 acre) to per-acre
avg_yield_acre <- y_bar_ld * 100
avg_yield_acre

# Correlation coefficient (r)
r <- s_xy / sqrt(s2_x * s2_y); r
r2 <- r^2; r2

# Variance for Double Sampling Regression
