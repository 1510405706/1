# Load the dplyr package
library(dplyr)
#Setup your working directory
setwd("F:/Bioinformatics/For Poster/THC")

# Load the dataset
results=read.csv("GSE3678.top.table.csv", header=TRUE)
head(results)
dim(results)

##Select Upregulated genes
Upregulated_data<- results %>% filter(  adj.P.Val <0.05 & logFC >1.5)
dim(Upregulated_data)
head(Upregulated_data)
UPDE <- dplyr::filter(Upregulated_data, !is.na(Gene.symbol))
tail(UPDE )
dim(UPDE )
write.csv(UPDE ,file="UPDE_1.csv")

##Select Downregulated genes
Downregulated_data <- results %>% filter(  adj.P.Val <0.05 & logFC < -1.5)
dim(Downregulated_data)
head(Downregulated_data)
DownDE <- dplyr::filter(Downregulated_data, !is.na(Gene.symbol))
tail(DownDE)
dim(DownDE)
write.csv(DownDE,file="DownDE_1.csv")

