# Load the library
library(randomForest)

# Set random seed for reproducibility
set.seed(42)

# Sample row indices for training data (70% of the dataset)
train_indices <- sample(1:nrow(iris), 0.7 * nrow(iris))

# Split the dataset
train_data <- iris[train_indices, ]
test_data  <- iris[-train_indices, ]

# Train a classification model
rf_model <- randomForest(Species ~ ., 
                         data = train_data, 
                         ntree = 500,        # Number of decision trees to grow
                         mtry = 2,           # Variables tried at each split
                         importance = TRUE)  # Calculate feature importance

# Print basic model summary
print(rf_model)

# Predict on testing data
predictions <- predict(rf_model, newdata = test_data)

# Generate a confusion matrix to evaluate accuracy
evaluation_matrix <- table(Observed = test_data$Species, Predicted = predictions)
print(evaluation_matrix)

# Calculate overall accuracy
accuracy <- sum(diag(evaluation_matrix)) / sum(evaluation_matrix)
print(paste("Test Accuracy:", round(accuracy * 100, 2), "%"))

# Plot the importance of each feature

importance(rf_model)
varImpPlot(rf_model)





